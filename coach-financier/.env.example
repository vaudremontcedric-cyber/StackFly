# Copie ce fichier en ".env" et remplis ta clé API Anthropic
# Tu peux obtenir une clé sur : https://console.anthropic.com/

ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxx

# Port du serveur (optionnel, défaut : 3000)
PORT=3000

# Secret de session (change-le pour la production)
SESSION_SECRET=change-moi-en-production-2024
